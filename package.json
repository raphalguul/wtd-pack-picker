{
  "name": "wtd-pack-picker",
  "version": "3.2.0",
  "description": "External pack selector for What The Dub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build-save-handler": "powershell -ExecutionPolicy Bypass -File save-handler/build.ps1",
    "build-window-embed": "powershell -ExecutionPolicy Bypass -File window-embed/build.ps1",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wtd.pack-picker",
    "productName": "WTD Pack Picker",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "save-handler/bin",
        "to": "save-handler"
      },
      {
        "from": "audio-handler/bin",
        "to": "audio-handler"
      },
      {
        "from": "window-embed/bin",
        "to": "window-embed"
      },
      {
        "from": "workshop-names.json",
        "to": "workshop-names.json"
      }
    ],
    "files": [
      "main.js",
      "server.js",
      "renderer/**/*",
      "lib/**/*",
      "!**/*.map",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!**/*.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "raphalguul",
      "repo": "wtd-pack-picker",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "WTD-Pack-Picker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "WTD Pack Picker"
    }
  }
}
