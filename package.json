{
  "name": "wtd-pack-picker",
  "version": "1.0.0",
  "description": "External pack selector for What The Dub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build-save-handler": "powershell -ExecutionPolicy Bypass -File save-handler/build.ps1",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wtd.pack-picker",
    "productName": "WTD Pack Picker",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "save-handler/bin",
        "to": "save-handler"
      },
      {
        "from": "audio-handler",
        "to": "audio-handler"
      },
      {
        "from": "workshop-names.json",
        "to": "workshop-names.json"
      }
    ],
    "files": [
      "main.js",
      "server.js",
      "renderer/**/*",
      "lib/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "WTD Pack Picker"
    }
  }
}
